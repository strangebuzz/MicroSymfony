# define your env variables for the test env here
#
# Note: .env.local is NOT loaded in the test environment, so this file is the right
# place to override the infrastructure configuration used by the test suite.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Use a dedicated SQLite file so that running the test suite (the Foundry "ResetDatabase"
# trait drops the schema) never destroys the dev database. If you switch to
# MySQL/PostgreSQL, drop this line: the "dbname_suffix" set in config/packages/doctrine.php
# takes over. @see config/packages/doctrine.php
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
